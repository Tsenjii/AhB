{
  "listen": "127.0.0.1:8317",
  "allow_lan": false,
  "providers": [
    {
      "id": "opencode",
      "display_name": "OpenCode Free",
      "description": "OpenCode Zen / Zen Go gateway",
      "enabled": true,
      "kind": "sidecar",
      "base_url": "http://127.0.0.1:8401",
      "ui_url": "http://127.0.0.1:8404/",
      "docs_url": "https://github.com/jasonxu114514/opencode2api",
      "binary": "./bin/opencode2api",
      "args": [
        "-config",
        "config.json"
      ],
      "work_dir": "./data/opencode",
      "env": {
        "GODEBUG": "netdns=cgo"
      },
      "headers": {
        "Authorization": "Bearer __AIHUB_SERVER_KEY__"
      },
      "health_path": "/healthz",
      "models_path": "/v1/models",
      "max_restarts": 3,
      "startup_timeout_seconds": 60
    },
    {
      "id": "freebuff",
      "display_name": "FreeBuff",
      "description": "FreeBuff / CodeBuff multi-account gateway",
      "enabled": true,
      "kind": "sidecar",
      "base_url": "http://127.0.0.1:8402",
      "ui_url": "http://127.0.0.1:8402/ui",
      "docs_url": "https://github.com/lza6/Freebuff-2API",
      "binary": "./bin/freebuff2api",
      "work_dir": "./data/freebuff",
      "env": {
        "RUST_LOG": "info"
      },
      "health_path": "/healthz",
      "models_path": "/v1/models",
      "max_restarts": 3
    },
    {
      "id": "agent2api",
      "display_name": "Agent2API",
      "description": "Optional: WorkBuddy CN/Intl / KukuAI / CodeArts / Qoder / Cline / Trae / Loomy and more",
      "enabled": false,
      "kind": "sidecar",
      "base_url": "http://127.0.0.1:8403",
      "ui_url": "http://127.0.0.1:8403/",
      "docs_url": "https://github.com/aimod-cc/agent2api",
      "binary": "./bin/agent2api-server",
      "work_dir": "./data/agent2api",
      "env": {
        "AGENT2API_HOST": "127.0.0.1",
        "AGENT2API_PROXY_PORT": "8403",
        "AGENT2API_PROXY_HOME": ".",
        "AGENT2API_UI_DIR": "./ui",
        "AGENT2API_ALLOW_NO_KEY": "1"
      },
      "health_path": "/health",
      "models_path": "/v1/models",
      "max_restarts": 3,
      "startup_timeout_seconds": 60
    },
    {
      "id": "deepseek",
      "display_name": "DeepSeek Web",
      "description": "Optional: DeepSeek Web multi-account gateway via Deepseek2API",
      "enabled": false,
      "kind": "sidecar",
      "base_url": "http://127.0.0.1:8405",
      "ui_url": "http://127.0.0.1:8405/admin",
      "docs_url": "https://github.com/zengtao227/Deepseek2API",
      "binary": "./bin/deepseek2api",
      "work_dir": "./data/deepseek2api",
      "env": {
        "PORT": "8405",
        "Deepseek2API_CONFIG_PATH": "config.json",
        "Deepseek2API_STATIC_ADMIN_DIR": "static/admin",
        "Deepseek2API_ADMIN_KEY": "__AIHUB_DEEPSEEK_ADMIN_KEY__",
        "GODEBUG": "netdns=cgo",
        "NO_PROXY": "127.0.0.1,localhost"
      },
      "headers": {
        "Authorization": "Bearer __AIHUB_SERVER_KEY__"
      },
      "health_path": "/healthz",
      "models_path": "/v1/models",
      "max_restarts": 3,
      "startup_timeout_seconds": 60
    },
    {
      "id": "grok",
      "display_name": "Grok",
      "description": "Optional: Grok Build / Web / Console multi-account gateway via Grok2API",
      "enabled": false,
      "kind": "sidecar",
      "base_url": "http://127.0.0.1:8407",
      "ui_url": "http://127.0.0.1:8407/",
      "docs_url": "https://github.com/chenyme/grok2api",
      "binary": "./bin/grok2api",
      "args": [
        "--config",
        "config.yaml",
        "--listen",
        "127.0.0.1:8407"
      ],
      "work_dir": "./data/grok2api",
      "headers": {
        "Authorization": "Bearer __AIHUB_GROK_CLIENT_KEY__"
      },
      "health_path": "/readyz",
      "models_path": "/v1/models",
      "max_restarts": 3,
      "startup_timeout_seconds": 90
    },
    {
      "id": "lmarena",
      "display_name": "LMArena External",
      "description": "Optional localhost OpenAI-compatible LMArena bridge; bridge implementation is not bundled",
      "enabled": false,
      "kind": "external",
      "base_url": "http://127.0.0.1:8406",
      "ui_url": "",
      "docs_url": "",
      "health_path": "/v1/models",
      "models_path": "/v1/models",
      "health_interval_seconds": 15
    }
  ],
  "routes": [],
  "routing": {
    "route_aliases_enabled": false,
    "same_model_fallback": {
      "enabled": false,
      "mode": "balanced",
      "providers": [
        "opencode",
        "agent2api",
        "freebuff",
        "deepseek",
        "lmarena",
        "grok"
      ]
    }
  }
}
